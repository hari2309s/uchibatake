# Supabase (sync + auth) — added in the sync phase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (plant diagnosis) — free-tier provider, server-side only
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: the daily note while the app is closed (Web Push). Generate keys with
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only (never NEXT_PUBLIC_):
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase › Project Settings › API keys › secret (service role) key, for the hourly tick:
SUPABASE_SECRET_KEY=
# A long random string; the same value goes in Supabase Vault as uchi_cron_secret:
UCHI_CRON_SECRET=
