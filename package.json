{
  "name": "uchibatake",
  "version": "0.10.0",
  "private": true,
  "description": "Grow a little food for the people you love.",
  "author": "Hariharan Selvaraj",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hari2309s/uchibatake.git"
  },
  "scripts": {
    "dev": "pnpm --filter @uchibatake/web dev",
    "build": "pnpm --filter @uchibatake/web build",
    "start": "pnpm --filter @uchibatake/web start",
    "lint": "pnpm --filter @uchibatake/web lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "test": "pnpm -r test",
    "e2e:install": "pnpm --filter @uchibatake/web exec playwright install chromium",
    "test:e2e": "pnpm --filter @uchibatake/web test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.25.0"
}
